# Azure AI Foundry agent (Responses protocol) — used by app/api/ask/route.ts
# Copy to .env.local and fill in. .env.local is gitignored.

# Foundry PROJECT endpoint (not the long .../protocols/openai/responses URL):
# https://<resource>.services.ai.azure.com/api/projects/<project>
AZURE_AI_PROJECT_ENDPOINT=

# The agent's name as shown in Foundry (e.g. PrajwalAI)
AZURE_AI_AGENT_NAME=

# Optional: pin a published version (e.g. 5). Leave blank to use the latest/active version.
AZURE_AI_AGENT_VERSION=

# ── AUTH: pick ONE ───────────────────────────────────────────────────────────
# Option A (recommended for Vercel — no Entra ID / app-registration needed):
# the Foundry resource API key. Portal -> the AI resource -> "Keys and Endpoint".
# When set, the route uses key auth and ignores the Entra vars below.
AZURE_AI_API_KEY=

# Option B (Entra ID): leave AZURE_AI_API_KEY blank to use DefaultAzureCredential.
# Locally this rides your `az login`. Off-Azure (Vercel) it needs a service
# principal below, which requires Entra app-registration rights.
# The SP needs the "Azure AI User" role on the Foundry resource.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
